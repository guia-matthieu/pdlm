# Gabarit — copier en .env et compléter. .env n'est jamais versionné.
# Valeurs par défaut : pile de développement (docker-compose.dev.yml).
# Tableau complet et obligations en production : README, « Variables d'environnement ».

# --- Application (Payload / Next.js) ---
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/pdlm
# Aléatoire et propre à chaque déploiement : openssl rand -hex 32
PAYLOAD_SECRET=
# Origine de l'admin (CORS/CSRF). Absente : /admin renvoie 404 sur les domaines communaux.
ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domaine racine de la plateforme (sous-domaine communal = <slug>.<domaine>).
# Vide : accepté en développement, refusé en production.
PLATFORM_DOMAIN=
# Développement uniquement : commune servie sur un host local nu (ignoré en production)
DEFAULT_COMMUNE_SLUG=saint-ex

# --- Stockage S3 / Garage ---
# false : fichiers sur disque local (dossier media/)
S3_ENABLED=true
S3_BUCKET=pdlm
S3_REGION=fr-1
S3_ENDPOINT=http://localhost:3900
# Clé de l'app, importée par le service init-s3. Défauts de développement ;
# la démo en ligne exige un identifiant et un secret sans défaut.
S3_ACCESS_KEY_ID=pdlm-app
S3_SECRET_ACCESS_KEY=motdepasse-a-changer
# Hôte public des fichiers — réservé : aucune commune ne peut le prendre comme domaine
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:3900

# --- Infrastructure (docker-compose.yml, production) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pdlm
# Secret RPC du cluster Garage : EXACTEMENT 64 caractères hexadécimaux
# (openssl rand -hex 32 — Garage décode la valeur telle quelle).
GARAGE_RPC_SECRET=
# Jeton de l'API d'administration Garage (services init-s3 et quota).
GARAGE_ADMIN_TOKEN=
# Secret de la clé S3 de l'app (même valeur que S3_SECRET_ACCESS_KEY).
S3_APP_PASSWORD=
# Quota dur du bucket, posé par l'API d'administration (scripts/garage-init.mjs,
# conversion testée en unit). Vide ou absent : aucun quota — la production n'a
# pas de raison de borner son stockage. La démo en ligne le pose via
# DEMO_S3_QUOTA (docker-compose.demo.yml).
#S3_QUOTA=2GiB
# ./Caddyfile en production (TLS) ; ./Caddyfile.dev par défaut (démo sans TLS)
CADDY_FILE=./Caddyfile.dev
