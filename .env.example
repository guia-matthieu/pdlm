# Gabarit — copier en .env et compléter. .env n'est jamais versionné.
# Valeurs par défaut : pile de développement (docker-compose.dev.yml).
# Tableau complet et obligations en production : README, « Variables d'environnement ».

# --- Application (Payload / Next.js) ---
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/pdlm
# Aléatoire et propre à chaque déploiement : openssl rand -hex 32
PAYLOAD_SECRET=
# Origine de l'admin (CORS/CSRF). Absente : /admin renvoie 404 sur les domaines communaux.
ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domaine racine de la plateforme (sous-domaine communal = <slug>.<domaine>).
# Vide : accepté en développement, refusé en production.
PLATFORM_DOMAIN=
# Développement uniquement : commune servie sur un host local nu (ignoré en production)
DEFAULT_COMMUNE_SLUG=saint-ex

# --- Stockage S3 / MinIO ---
# false : fichiers sur disque local (dossier media/)
S3_ENABLED=true
S3_BUCKET=pdlm
S3_REGION=fr-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Hôte public des fichiers — réservé : aucune commune ne peut le prendre comme domaine
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000

# --- Infrastructure (docker-compose.yml, production) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pdlm
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_APP_PASSWORD=
# ./Caddyfile en production (TLS) ; ./Caddyfile.dev par défaut (démo sans TLS)
CADDY_FILE=./Caddyfile.dev
